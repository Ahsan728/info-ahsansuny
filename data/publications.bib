@misc{ahsan2026photoscale,
  abbr         = {Poster},
  title        = {PhotoScale: An Automated Continuous-Flow Photoreactor for Data-Driven Photocatalysis},
  author       = {Ahsan, M. S. and Giziński, D. and Lloret-Fillol, J.},
  howpublished = {Poster, ICIQ Summer School 2026},
  year         = {2026},
  month        = {jul},
  pdf          = {/files/photoscale-poster-iciq-summer-school-2026.pdf},
  abstract     = {PhotoScale is an automated continuous-flow photoreactor built at ICIQ as a platform for data-driven, autonomous photocatalysis. Optimising a new transformation means searching a high-dimensional space (catalyst loading, chemicals, solvents, photon flux, residence time, temperature) where manual screening limits throughput and reproducibility. PhotoScale embeds sensing, control and logging in the hardware and defines a layered upgrade path: structured logging with quality-control gating, machine-vision kinetics, edge-AI closed-loop optimisation, and an LLM pipeline distilling catalyst knowledge from the literature.}
}
